# Copy to .env for local use (never commit real values). On Railway, set these as service variables.

NODE_ENV=production
# Public URL of the portal. On Railway this is derived from RAILWAY_PUBLIC_DOMAIN automatically.
PUBLIC_URL=https://your-portal.up.railway.app
# Long random string (48+ chars). Rotating it signs everyone out.
SESSION_SECRET=
# Where the SQLite database and evidence attachments live. Must be a mounted volume on Railway.
DATA_DIR=/data

# Discord application (one app serves both the bot and "Sign in with Discord")
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Optional. Can also be set from Settings -> Discord & roles.
DISCORD_TICKET_CATEGORY_ID=
DISCORD_LOG_CHANNEL_ID=

# Break-glass Head of IA accounts (comma-separated Discord user IDs). Always director, cannot be suspended.
IA_OWNER_DISCORD_IDS=

# AI drafting: gemini | groq | openai | ollama | none
AI_PROVIDER=gemini
AI_API_KEY=
# Optional model override. Defaults: gemini-2.5-flash, llama-3.3-70b-versatile (groq), llama3.1:8b (ollama)
AI_MODEL=
# Required for ollama or any OpenAI-compatible endpoint
AI_BASE_URL=
AI_MAX_INPUT_CHARS=60000

# Seed demo cases so the portal can be evaluated. Purge them from Settings -> System.
SEED_DEMO=false

# First case number for the portal (continues the paper series)
CASE_NUMBER_START=644
